# Default deny: private local work records coexist with public source.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.txt
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/build.mjs
!/package_plugin.py
!/server.py
!/knowledge.py
!/markdown_vault.py
!/astra.py
!/test_workbench.py
!/test_reading.py
!/test_portable.py
!/test_release.py
!/ui/
!/ui/*.jsx
!/ui/*.css
!/plugin/
!/plugin/main.js
!/plugin/styles.css
!/plugin/manifest.json
!/plugin/requirements.txt
!/plugin/README.md
!/dist/
!/dist/index.html
!/dist/main.js
!/dist/main.css
!/tools/
!/tools/install.py
!/tools/test_plugin.cjs
!/tools/demo.py
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.jpg
!/examples/
!/examples/demo-vault/
!/examples/demo-vault/**/
!/examples/demo-vault/**/*.md
!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml
**/__pycache__/
**/*.pyc


!/tools/verify_release.py
